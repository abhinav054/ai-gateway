OPENAI_API_KEY=sk-your-real-openai-key
GATEWAY_KEY_STORE=sqlite
GATEWAY_SQLITE_PATH=gateway_keys.db

# Optional:
# GATEWAY_ADMIN_TOKEN=change-me
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_ORGANIZATION=org_...
# OPENAI_PROJECT=proj_...
# UPSTREAM_TIMEOUT_SECONDS=600
#
# PostgreSQL key storage:
# GATEWAY_KEY_STORE=postgres
# GATEWAY_POSTGRES_DSN=postgresql://user:password@localhost:5432/ai_gateway
#
# Optional Redis cache for PostgreSQL key lookups:
# GATEWAY_REDIS_URL=redis://localhost:6379/0
# GATEWAY_REDIS_CACHE_TTL_SECONDS=300
